# ==============================================================================
# TrustChain AI — Environment Configuration Template
# ==============================================================================
# Role: Member 3 (Supabase, Data Persistence, Evidence Layer & Security)
# Copy this file to .env and configure with your credentials.
# NEVER commit the actual .env file with secrets to version control.
# ==============================================================================

# Supabase Project Configuration (From Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-secret-key

# Direct PostgreSQL Connection String (Optional, for direct migrations/pooling)
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# Supabase Storage Buckets
STORAGE_BUCKET_DOCUMENTS=case-documents
STORAGE_BUCKET_REPORTS=case-reports
STORAGE_SIGNED_URL_EXPIRY_SECONDS=3600

# Security & Tenant Defaults
DEFAULT_CURRENCY=INR
MAX_UPLOAD_SIZE_BYTES=15728640  # 15 MB limit per document
ALLOWED_UPLOAD_MIME_TYPES=application/pdf

# TinyFish Integration (Owned by Member 1)
# Note: Sensitive API keys must remain backend-only. Never expose to client.
TINYFISH_API_KEY=your-tinyfish-api-key-here
TINYFISH_BASE_URL=https://api.tinyfish.ai/v1

# Environment Mode
ENVIRONMENT=development
LOG_LEVEL=INFO
