# Server-only configuration. Copy to .env; never commit credentials.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Connect -> Session pooler; use the existing database password, URL encoded.
DATABASE_URL=
REPOSITORY_FACTORY=app.supabase_adapter:create_repository
FRONTEND_ORIGIN=http://localhost:3000
ENVIRONMENT=development
STORAGE_BUCKET_DOCUMENTS=case-documents
STORAGE_BUCKET_REPORTS=case-reports
MAX_UPLOAD_SIZE_BYTES=10000000
TINYFISH_API_KEY=
PUBLIC_RESEARCH_HOSTS=example.com
# Explicit live verification, dedicated test project only. Keep test tokens private.
TRUSTCHAIN_LIVE_TESTS=0
TRUSTCHAIN_TEST_PROJECT_REF=
TRUSTCHAIN_TEST_BUYER_ACCESS_TOKEN=
TRUSTCHAIN_TEST_REVIEWER_ACCESS_TOKEN=
